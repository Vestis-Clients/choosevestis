# ---- Server-only (never sent to the browser) ----
# From resend.com > API Keys (Sending access, choosevestis.com only).
RESEND_API_KEY=
# Where form submissions are delivered
CONTACT_TO_EMAIL=contact@choosevestis.com
# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=Vestis Website <website@choosevestis.com>
# WhatsApp Business short link (wa.me/message/XXXX) or wa.me/<number>. Empty = button hidden.
WHATSAPP_URL=
# Facebook Page username (facebook.com/<this>). Empty = button hidden.
MESSENGER_PAGE=

# ---- Public ----
# Mailbox name shown on the site; the @choosevestis.com part is added in the browser.
NEXT_PUBLIC_CONTACT_EMAIL_USER=contact
# Founding spots still open (0-3). Empty = no counter shown.
NEXT_PUBLIC_FOUNDING_SPOTS_LEFT=
