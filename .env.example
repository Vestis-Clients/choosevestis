# ---- Server-only (secret) ----
# From resend.com > API Keys. Required for the contact form to send.
RESEND_API_KEY=
# Where form submissions are delivered
CONTACT_TO_EMAIL=contact@choosevestis.com
# Sender address. Must be on a domain you've verified in Resend.
CONTACT_FROM_EMAIL=Vestis Website <website@choosevestis.com>

# ---- Public (shown on the site) ----
NEXT_PUBLIC_CONTACT_EMAIL=contact@choosevestis.com
# Digits only with country code, e.g. 17045551234. Empty = WhatsApp button hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Facebook Page username (facebook.com/<this>). Empty = Messenger button hidden.
NEXT_PUBLIC_MESSENGER_PAGE=
# Your phone for Text + Call buttons, e.g. +17045551234. Empty = hidden.
NEXT_PUBLIC_PHONE=
# Founding spots still open (0-3). Empty = no counter shown.
NEXT_PUBLIC_FOUNDING_SPOTS_LEFT=
